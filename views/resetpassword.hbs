<div class="card">
  <h2>Reset Your Password</h2>
  {{#if error}}
    <div class="error-message" style="color: #D8000C; background-color: #FFD2D2; border: 1px solid #D8000C; padding: 10px; border-radius: 5px; margin-bottom: 15px; text-align: center;">
      {{error}}
    </div>
  {{/if}}

  <form  id="auth-form" method="POST">
    <label for="password">New Password</label>
    <input type="password" id="password" name="password" required>
    
    <label for="confirmPassword">Confirm New Password</label>
    <input type="password" id="confirmPassword" name="confirmPassword" required>
    
    <!-- The token is in the URL, so the POST action will go to /resetpassword/:token -->
    <button type="submit" class="signin-btn">Update Password</button>
  </form>

  <p class="signup-text">
    Remembered your password? <a href="/signin">Sign In</a>
  </p>
</div>
