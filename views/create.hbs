<div class="card">
  <h2>Create Event</h2>

  <form method="POST" action="/events"> 
    
    <div class="form-group">
      <label for="title">Event Title</label>
      <input type="text" id="title" name="title" required>
    </div>


    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="4"></textarea>
    </div>

    <div class="form-group">
      <label for="sport">Sport</label>
      <select id="sport" name="sport" required>
        <option value="" disabled selected>Select a sport</option>
        {{#each sports}}
          {{! Assumes you pass an array of 'sports' from your route }}
          {{! The value is the sport's ID, which matches your schema ref }}
          <option value="{{this._id}}">{{this.name}}</option>
        {{/each}}
      </select>
    </div>

    {{! Location }}
    <div class="form-group">
      <label for="location">Location</label>
      <input type="text" id="location" name="location" required>
    </div>

    {{! Date }}
    <div class="form-group">
      <label for="date">Date</label>
      {{! Using type="date" gives you the calendar picker from the image }}
      <input type="date" id="date" name="date" required>
    </div>

    {{! Time }}
    <div class="form-group">
      <label for="time">Time</label>
      {{! Using type="time" gives you the clock picker from the image }}
      <input type="time" id="time" name="time" required>
    </div>

    {{! Fee (optional) }}
    <div class="form-group">
      <label for="fee">Fee (optional)</label>
      <input type="number" id="fee" name="fee" min="0" step="0.01" placeholder="0.00">
    </div>

    {{! Number of Player Slots }}
    <div class="form-group">
      <label for="slots">Number of Player Slots</label>
      <input type="number" id="slots" name="slots" min="1" required>
    </div>

    {{! Submit Button }}
    <button type="submit" class="create-btn">Create Event</button>
  </form>
</div>