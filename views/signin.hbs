  <div class="card">
    <h2>Sign In</h2>
      {{#if error}}
          <div class="error-message" style="color: #D8000C; background-color: #FFD2D2; border: 1px solid #D8000C; padding: 10px; border-radius: 5px; margin-bottom: 15px; text-align: center;">
            {{error}}
          </div>
       {{/if}}

    <form id="auth-form" method="POST">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required>

      <label for="password">Password</label>
      <input type="password" id="password" name="password" required>

      <button type="submit" class="signin-btn">Sign In</button>
    </form>

    <div class="social-buttons">
      <a href="/login/federated/google" class="google-btn">
        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/google/google-original.svg" alt="Google" class="icon">
         Continue with Google
      </a>

      <a href="/login/federated/github" class="github-btn">
        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg" alt="GitHub" class="icon">
        Continue with GitHub
      </a>

    <p class="signup-text">
      Don't have an account? <a href="/signup">Sign Up</a> <br/><br/>
      Forgot your password? <a href="/forgotpassword">Reset</a>
    </p>
  </div>