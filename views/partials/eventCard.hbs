<div class="event-card">
  <h2 class="event-card-title">{{this.title}}</h2>
  
  <div class="event-card-details">
    <div class="detail-item">
      {{!-- <span class="detail-icon">⚽</span> --}}
      <span class="detail-text">{{this.sport.name}}</span>
    </div>
    <div class="detail-item">
      <span class="detail-icon">📍</span>
      <span class="detail-text">{{this.location}}</span>
    </div>
    <div class="detail-item">
      <span class="detail-icon">📅</span>
      <span class="detail-text">{{this.formattedDate}}, {{this.formattedTime}}</span>
    </div>
    <div class="detail-item">
      <span class="detail-icon">👥</span>
      <span class="detail-text">{{this.slots}} Slots Remaining</span>
    </div>
  </div>

  <a href="/events/{{this._id}}" class="event-card-button">Read More</a>
  
  <div class="action-container">
    <button class="action-btn save-btn" data-id="{{this._id}}">
      <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
      </svg>
    </button>
    <button class="action-btn join-btn" data-id="{{this._id}}">
      <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
  </button>
  </div>
</div>