<div class="events-page-container">
  <div class="my-events-header">
    <h1 class="events-page-title">My Events</h1>
    <button class="btn btn-primary" id="open-create-modal-btn">Create New Event</button>
  </div>

  <div id="events-content-container">
    <div class="table-responsive">
      <table class="events-table">
        <thead>
          <tr>
            <th>Event</th>
            <th>Sport</th>
            <th>Location</th>
            <th>Date</th>
            <th>Time</th>
            <th>Availability</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="events-table-body">
          <tr>
            <td colspan="7">Loading events...</td>
          </tr>
        </tbody>
      </table>
    </div>
  
    <div class="pagination-controls">
      <div class="page-size-selector">
        <label for="page-size-select">Show:</label>
        <select id="page-size-select">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50">50</option>
        </select>
        <span id="total-events-info"></span>
      </div>
      <div class="page-navigator">
        <button id="prev-page-btn" disabled>&larr; Previous</button>
        <span id="page-info">Page 1 of 1</span>
        <button id="next-page-btn" disabled>Next &rarr;</button>
      </div>
    </div>
  </div>

</div>

<dialog id="modal-leave" class="modal">
  {{#if user}}
    <div class="modal-content">
      <button class="close-btn" id="close-leave">&times;</button>
      <h2 id="event-title-leave" class="event-title">Leave Event?</h2>

      <form id="leave-form">
        <div id="modal-message-leave" class="modal-message"></div>
        
        <p>Are you sure you want to leave this event?</p>

        <input type="hidden" id="event-id-leave" name="event_id" value="">

        <div class="modal-actions">
          <button type="submit" class="btn btn-danger" id="confirm-leave-btn">Confirm Leave</button>
          <button type="button" class="btn btn-secondary" id="cancel-leave">Cancel</button>
        </div>
      </form>
    </div>
  {{else}}
    <div class="modal-content">
      <button class="close-btn" id="close-leave">&times;</button>
      <h2 class="modal-title">Sign In Required</h2>
      <p>You must be signed in to manage your events.</p>
      <div class="modal-actions">
        <a href="/signin" class="btn btn-primary">Sign In</a>
        <button type="button" class="btn btn-secondary" id="cancel-leave">Cancel</button>
      </div>
    </div>
  {{/if}}
</dialog>

<dialog id="modal-delete" class="modal">
  {{#if user}}
    <div class="modal-content">
      <button class="close-btn" id="close-delete">&times;</button>
      <h2 id="event-title-delete" class="event-title">Delete Event?</h2>

      <form id="delete-form">
        <div id="modal-message-delete" class="modal-message"></div>
        
        <p>Are you sure you want to permanently delete this event? This cannot be undone.</p>

        <input type="hidden" id="event-id-delete" name="event_id" value="">

        <div class="modal-actions">
          <button type="submit" class="btn btn-danger" id="confirm-delete-btn">Confirm Delete</button>
          <button type="button" class="btn btn-secondary" id="cancel-delete">Cancel</button>
        </div>
      </form>
    </div>
  {{else}}
    <div class="modal-content">
      <button class="close-btn" id="close-delete">&times;</button>
      <h2 class="modal-title">Sign In Required</h2>
      <p>You must be signed in to manage your events.</p>
      <div class="modal-actions">
        <a href="/signin" class="btn btn-primary">Sign In</a>
        <button type="button" class="btn btn-secondary" id="cancel-delete">Cancel</button>
      </div>
    </div>
  {{/if}}
</dialog>

<dialog id="modal-create" class="modal">
  {{#if user}}
    <div class="modal-content">
      <button class="close-btn" id="close-create">&times;</button>
      <h2 id="event-title-create" class="event-title">Create New Event</h2>

      <form id="create-form">
        <div id="modal-message-create" class="modal-message"></div>
        
        <div class="form-group">
          <label for="create-title">Event Title</label>
          <input type="text" id="create-title" name="title" required>
        </div>

        <div class="form-group">
          <label for="create-sport">Sport</label>
          <select id="create-sport" name="sport" required>
            <option value="">Loading sports...</option>
          </select>
        </div>

        <div class="form-group">
          <label for="create-location">Location</label>
          <input type="text" id="create-location" name="location" required>
        </div>

        <div class="form-group-row">
          <div class="form-group">
            <label for="create-date">Date</label>
            <input type="date" id="create-date" name="date" required>
          </div>
          <div class="form-group">
            <label for="create-time">Time</label>
            <input type="time" id="create-time" name="time" required>
          </div>
        </div>

        <div class="form-group-row">
            <div class="form-group">
                <label for="create-slots">Slots (Capacity)</label>
                <input type="number" id="create-slots" name="slots" min="1" required>
            </div>
            <div class="form-group">
                <label for="create-fee">Fee ($)</label>
                <input type="number" id="create-fee" name="fee" min="0" value="0" required>
            </div>
        </div>

        <div class="form-group">
          <label for="create-description">Description</label>
          <textarea id="create-description" name="description" rows="3"></textarea>
        </div>

        <div class="form-group">
          <label for="create-requirements">Requirements (e.g., "Bring shin guards")</label>
          <textarea id="create-requirements" name="requirements" rows="2"></textarea>
        </div>

        <div class="modal-actions">
          <button type="submit" class="btn btn-primary" id="confirm-create-btn">Confirm Create</button>
          <button type="button" class="btn btn-secondary" id="cancel-create">Cancel</button>
        </div>
      </form>
    </div>  
  {{/if}}

</dialog>

<script src="/myEvents.js"></script>