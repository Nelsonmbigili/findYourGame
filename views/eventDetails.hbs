<div class="event-container">
  <!-- Event Image -->
  {{#if event.image}}
    <div class="event-image">
      <img src="{{event.image}}" alt="{{event.title}}">
    </div>
  {{/if}}

  <!-- Event Table -->
  <table class="event-table">
    <thead>
      <tr>
        <th colspan="2" class="event-title-header">{{event.title}}</th>
      </tr>
    </thead>
    <tbody>
      {{#if event.description}}
        <tr>
          <th>Description</th>
          <td>{{event.description}}</td>
        </tr>
      {{/if}}

      <tr>
        <th>Sport</th>
        <td>{{event.sport.name}}</td>
      </tr>
      <tr>
        <th>Location</th>
        <td>{{event.location}}</td>
      </tr>
      <tr>
        <th>Date & Time</th>
        <td>{{event.formattedDate}} at {{event.formattedTime}}</td>
      </tr>
      <tr>
        <th>Fee</th>
        <td>
          {{#if event.fee}}
            ${{event.fee}}
          {{else}}
            Free!
          {{/if}}
        </td>
      </tr>
      {{#if event.requirements}}
        <tr>
          <th>Requirements</th>
          <td>{{event.requirements}}</td>
        </tr>
      {{/if}}
      <tr>
        <th>Slots</th>
        <td>{{event.participants.length}} / {{event.slots}} filled</td>
      </tr>
    </tbody>
  </table>

  <!-- Participants (if shown) -->
    {{#if showParticipants}}
      <section class="participants-section">
        <h3>Participants</h3>
        <div class="avatars">
         {{#each participants}}
            <a href="/profiles/{{this.username}}" class="avatar" title="{{this.name.firstName}} {{this.name.secondName}}">
              {{#if this.image}}
                <img src="{{this.image}}" alt="{{this.name.firstName}}">
              {{else}}
                {{this.name.firstName.[0]}}{{this.name.secondName.[0]}}
              {{/if}}
            </a>
          {{/each}}
         {{#if hasMoreParticipants}}
            <a href="/profiles?event={{event._id}}" class="avatar more" style="text-decoration: none;" title="View all participants">+{{remainingCount}}</a>
          {{/if}}
        </div>
        <div class="participant-links">
            <a href="/events/participants?event={{event._id}}">View All Participants</a>
            <span style="color: #ccc;">|</span>
            <a href="/profiles">Find Other Players</a>
        </div>
      </section>
    {{/if}}


  <!-- Organizer Info -->
  <section class="organizer-section">
    <h3>Organizer</h3>
    <div class="organizer">
      <div class="organizer-avatar">{{ownerInitials}}</div>
      <div class="organizer-details">
        <p>{{event.owner.name.firstName}} {{event.owner.name.secondName}}</p>
        <p>{{event.owner.email}}</p>
      </div>
    </div>
  </section>

    <!-- Action Buttons -->
  <section class="event-actions">
      {{#if user}}
        
        <!-- 1. Management Buttons (Visible ONLY to Owner) -->
        {{#if owner}}
          <button class="btn" id="open-edit-btn">
            <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
     
          </button>
          <button class="btn btn-delete" id="open-delete-btn">
            <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              <line x1="10" y1="11" x2="10" y2="17"></line>
              <line x1="14" y1="11" x2="14" y2="17"></line>
            </svg>

          </button>
        {{/if}}

        <!-- 2. Participation Buttons (Visible to EVERYONE, including Owner) -->
        
        {{#if isParticipant}}
          <!-- User has joined -->
          <button class="btn" id="open-leave-btn">
            <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>

          </button>

        {{else if isFull}}
          <button class="btn" disabled>
            <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
               <circle cx="12" cy="12" r="10"></circle>
               <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
            </svg>
          </button>

        {{else}}
          <!-- User has NOT joined -->
          <button class="btn join-btn" id="open-register-btn">
            <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="8.5" cy="7" r="4"></circle>
              <line x1="20" y1="8" x2="20" y2="14"></line>
              <line x1="23" y1="11" x2="17" y2="11"></line>
            </svg>

          </button>
        {{/if}}

      {{else}}
        <!-- Guest -->
        <a href="/signin" class="btn">
          <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
            <polyline points="10 17 15 12 10 7"></polyline>
            <line x1="15" y1="12" x2="3" y2="12"></line>
          </svg>
        </a>
      {{/if}}
    </section>
</div>

{{!-- Register Dialog  --}}
<dialog id="modal-register" class="modal">

  {{#if user}}
    <div class="modal-content">
      <button class="close-btn" id="close-register">&times;</button>
      <h2 id="event-title" class="event-title">Register for Event</h2>

      <form id="register-form">
        <div id="modal-message" class="modal-message"></div>
        <div class="form-group">
          <label for="participant-name">Your Name:</label>
          <input type="text" id="participant-name" name="participant_name"
                 value="{{user.name.firstName}} {{user.name.secondName}}" readonly>
        </div>


        <div class="form-group">
          <label for="participant-email">Email:</label>
          <input type="email" id="participant-email" name="participant_email"
                 value="{{user.email}}" readonly>
        </div>

        <input type="hidden" id="event-id" name="event_id" value="{{event._id}}">

        <div class="modal-actions">
          <button type="submit" class="btn btn-primary">Confirm Registration</button>
          <button type="button" class="btn btn-secondary" id="cancel-register">Cancel</button>
        </div>
      </form>
    </div>
  {{else}}
    <div class="modal-content">
      <button class="close-btn" id="close-register">&times;</button>
      <h2 class="modal-title">Sign In Required</h2>
      <p>You must be signed in to register for events.</p>
      <div class="modal-actions">
        <a href="/signin" class="btn btn-primary">Sign In</a>
        <button type="button" class="btn btn-secondary" id="cancel-register">Cancel</button>
      </div>
    </div>
  {{/if}}

</dialog>

<dialog id="modal-leave" class="modal">
  <div class="modal-content">
    <button class="close-btn" id="close-leave">&times;</button>
    <h2 class="event-title">Leave Event?</h2>
    <form id="leave-form">
      <div id="modal-message-leave" class="modal-message"></div>
      <p>Are you sure you want to leave <strong>{{event.title}}</strong>?</p>
      <input type="hidden" name="event_id" value="{{event._id}}">
      <div class="modal-actions">
        <button type="submit" class="btn btn-danger" id="confirm-leave-btn">Confirm Leave</button>
        <button type="button" class="btn btn-secondary" id="cancel-leave">Cancel</button>
      </div>
    </form>
  </div>
</dialog>

<dialog id="modal-delete" class="modal">
  <div class="modal-content">
    <button class="close-btn" id="close-delete">&times;</button>
    <h2 class="event-title">Delete Event?</h2>
    <form id="delete-form">
      <div id="modal-message-delete" class="modal-message"></div>
      <p>Are you sure you want to permanently delete <strong>{{event.title}}</strong>? This cannot be undone.</p>
      <input type="hidden" name="event_id" value="{{event._id}}">
      <div class="modal-actions">
        <button type="submit" class="btn btn-danger" id="confirm-delete-btn">Confirm Delete</button>
        <button type="button" class="btn btn-secondary" id="cancel-delete">Cancel</button>
      </div>
    </form>
  </div>
</dialog>

<dialog id="modal-edit" class="modal">
  <div class="modal-content">
    <button class="close-btn" id="close-edit">&times;</button>
    <h2 class="event-title">Edit Event</h2>

    <form id="edit-form">
      <div id="modal-message-edit" class="modal-message"></div>
      <input type="hidden" name="eventId" value="{{event._id}}">

      <div class="form-group">
        <label for="edit-title">Event Title</label>
        <input type="text" id="edit-title" name="title" value="{{event.title}}" required>
      </div>

      <div class="form-group">
        <label for="display-sport">Sport</label>
        <input type="text" id="display-sport" value="{{event.sport.name}}" disabled >
      </div>

      <div class="form-group">
        <label for="edit-location">Location</label>
        <input type="text" id="edit-location" name="location" value="{{event.location}}" required>
      </div>

      <div class="form-group-row">
        <div class="form-group">
          <label for="edit-date">Date</label>
          <input type="date" id="edit-date" name="date" value="{{event.rawDate}}" required>
        </div>
        <div class="form-group">
          <label for="edit-time">Time</label>
          <input type="time" id="edit-time" name="time" value="{{event.time}}" required>
        </div>
      </div>

      <div class="form-group-row">
          <div class="form-group">
              <label for="edit-slots">Slots (Capacity)</label>
              <input type="number" id="edit-slots" name="slots" min="1" value="{{event.slots}}" required>
          </div>
          <div class="form-group">
              <label for="edit-fee">Fee ($)</label>
              <input type="number" id="edit-fee" name="fee" min="0" value="{{event.fee}}" required>
          </div>
      </div>

      <div class="form-group">
        <label for="edit-description">Description</label>
        <textarea id="edit-description" name="description" rows="3">{{event.description}}</textarea>
      </div>

      <div class="form-group">
        <label for="edit-requirements">Requirements</label>
        <textarea id="edit-requirements" name="requirements" rows="2">{{event.requirements}}</textarea>
      </div>

      <div class="modal-actions">
        <button type="submit" class="btn btn-primary" id="confirm-edit-btn">Save Changes</button>
        <button type="button" class="btn btn-secondary" id="cancel-edit">Cancel</button>
      </div>
    </form>
  </div>  
</dialog>

<dialog id="modal-register" class="modal"> ... (Your existing register code) ... </dialog>


<script src="/eventDetails.js"></script>