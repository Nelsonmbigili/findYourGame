<div class="card">
  <h2>Reset Password</h2>

  {{#if error}}
    <div class="error-message" style="color: #D8000C; background-color: #FFD2D2; border: 1px solid #D8000C; padding: 10px; border-radius: 5px; margin-bottom: 15px; text-align: center;">
      {{error}}
    </div>
  {{/if}}

  {{#if success}}
    <div class="success-message" style="color: #2F855A; background-color: #C6F6D5; border: 1px solid #2F855A; padding: 10px; border-radius: 5px; margin-bottom: 15px; text-align: center;">
      {{success}}
    </div>
  {{else}}
    <p style="text-align: center; margin-bottom: 15px; color: #555;">
      Enter your email and we'll send you a link to reset your password.
    </p>
    <form method="POST">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required>
      <button type="submit" class="signin-btn">Send Confirmation Email</button>
    </form>
  {{/if}}

  <p class="signup-text">
    Return to Sign in <a href="/signin">Sign In</a>
  </p>
</div>
