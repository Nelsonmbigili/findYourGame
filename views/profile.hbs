<div class="dashboard-container">
    <div class="profile-card">
        <div class="profile-header">
          <div class="profile-picture-container">
              {{#if profileUser.image}}
                <img src="{{profileUser.image}}" alt="Profile" class="profile-picture-img">
              {{else}}
                <div class="profile-initials">
                  {{profileUser.name.firstName.[0]}}{{profileUser.name.secondName.[0]}}
                </div>
              {{/if}}
            </div>
            <div class="profile-info">
              <h2>{{profileUser.name.firstName}} {{profileUser.name.secondName}}</h2>
              <p class="username">Username: {{profileUser.username}}</p>
              <p class="email">Email: {{profileUser.email}}</p>
          </div>
        </div>

        <div class="action-buttons" style="display: flex; justify-content: space-around; ">
            <button class="btn btn-primary" disabled title="Coming Soon" style="background: gray">
              <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
              </svg>
              Follow
            </button>

            <button class="btn btn-secondary" disabled title="Coming Soon" style="background: gray">
              <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
              Message
            </button>
        </div>

        <div class="info-grid">
          <div class="info-item">
            <div class="info-label">Phone</div>
            <div class="info-value">   
              {{#if profileUser.phone}}
                <div class="email">{{profileUser.phone}}</div>
            {{else}}
             <div class="email">Not Set</div>
            {{/if}}
           </div>
          </div>

          <div class="info-item">
            <div class="info-label">Member Since</div>
            <div class="info-value">{{profileUser.createdAt}}</div>
          </div>

          <div class="info-item">
            <div class="info-label">About</div>
            <div class="info-value">{{profileUser.about}}</div>
          </div>

            <div class="info-item">
              <div class="info-label">Preferred Sports</div>
              <div class="info-value">
                {{#if profileUser.sports.length}}
                  <div class="sports-tags-container">
                    {{#each profileUser.sports}}
                      <span class="sport-tag">{{this}},</span>
                    {{/each}}
                  </div>
                {{else}}
                  <span class="email">Not Set</span>
                {{/if}}
              </div>
            </div>
        </div>


    </div>
</div>