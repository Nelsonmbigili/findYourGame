<div class="events-page-container">
  <h1 class="events-page-title">Upcoming Sports Events</h1>

  <div class="search-filter-container">
    <div class="filter_and_search">
      <form class="search-form" id="search-form">
        <label for="search_query">Search Events:</label>
        <div class="search-box">
          <input type="text" id="search_query" name="search_query" placeholder="Enter event name...">
          <button type="submit" class="search-btn">Search</button>
        </div>
      </form>

      <form class="filter-form" id="filter-form">
        <select id="filter-by" name="filter_by">
          <option value="">Select Filter</option>
          <option value="sport">Sport Type</option>
          <option value="location">Location</option>
          <option value="time">Time</option>
          <option value="date">Date</option>
          <option value="fee">Fee</option>
          <option value="availability">Availability</option>
        </select>
        <select id="filter-option" name="filter_option">
          <option value="">Choose Option</option>
        </select>
        <button type="submit" class="apply-btn">Apply Filters</button>
      </form>
    </div>
  </div>

  <div id="events-content-container">
    <div class="table-responsive">
    <table class="events-table">
      <thead>
        <tr>
          <th>Event</th>
          <th>Sport</th>
          <th>Location</th>
          <th>Date</th>
          <th>Time</th>
          <th>Availability</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="events-table-body">
        <tr>
          <td colspan="7">Loading events...</td>
        </tr>
      </tbody>
    </table>
  </div>

    <div class="pagination-controls">
      <div class="page-size-selector">
        <label for="page-size-select">Show:</label>
        <select id="page-size-select">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50">50</option>
        </select>
        <span id="total-events-info"></span>
      </div>
      <div class="page-navigator">
        <button id="prev-page-btn" disabled>&larr; Previous</button>
        <span id="page-info">Page 1 of 1</span>
        <button id="next-page-btn" disabled>Next &rarr;</button>
      </div>
    </div>
  </div>
</div>

{{!-- Register Dialog  --}}
<dialog id="modal-register" class="modal">

  {{#if user}}
    <div class="modal-content">
      <button class="close-btn" id="close-register">&times;</button>
      <h2 id="event-title" class="event-title">Register for Event</h2>

      <form id="register-form">
        <div class="form-group">
          <label for="participant-name">Your Name:</label>
          <input type="text" id="participant-name" name="participant_name"
                 value="{{user.name.firstName}} {{user.name.secondName}}" readonly>
        </div>

        <div class="form-group">
          <label for="participant-email">Email:</label>
          <input type="email" id="participant-email" name="participant_email"
                 value="{{user.email}}" readonly>
        </div>

        <input type="hidden" id="event-id" name="event_id" value="{{event._id}}">

        {{!-- {{#if event.fee}}
        <fieldset class="payment-section">
          <legend>Payment Information</legend>
          <div class="form-group">
            <label for="card-number">Card Number:</label>
            <input type="text" id="card-number" name="card_number" placeholder="xxxx xxxx xxxx xxxx" required>
          </div>
          <div class="form-group">
            <label for="expiry-date">Expiry Date:</label>
            <input type="text" id="expiry-date" name="expiry_date" placeholder="MM/YY" required>
          </div>
          <div class="form-group">
            <label for="cvv">CVV:</label>
            <input type="text" id="cvv" name="cvv" placeholder="123" required>
          </div>
        </fieldset>
        {{/if}} --}}

        <div class="modal-actions">
          <button type="submit" class="btn btn-primary">Confirm Registration</button>
          <button type="button" class="btn btn-secondary" id="cancel-register">Cancel</button>
        </div>
      </form>
    </div>
  {{else}}
    <div class="modal-content">
      <button class="close-btn" id="close-register">&times;</button>
      <h2 class="modal-title">Sign In Required</h2>
      <p>You must be signed in to register for events.</p>
      <div class="modal-actions">
        <a href="/signin" class="btn btn-primary">Sign In</a>
        <button type="button" class="btn btn-secondary" id="cancel-register">Cancel</button>
      </div>
    </div>
  {{/if}}

</dialog>


<script src="events.js"></script>