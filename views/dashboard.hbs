      <div class="profile-card">
        <div class="profile-header">
          <div class="profile-picture-container">
              {{#if user.image}}
                <img src="{{user.image}}" alt="NA" class="profile-picture-img">
              {{else}}
                <div class="profile-initials">
                  {{user.name.firstName.[0]}}{{user.name.secondName.[0]}}
                </div>
              {{/if}}
              
              <button class="upload-overlay" id="open-image-modal-btn" type="button">
                <svg class="upload-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </button>
            </div>

          <div class="profile-info">
            <h2>{{user.name.firstName}} {{user.name.secondName}}</h2>
            <p class="username">Username: {{user.username}}</p>
            <p class="email">Email: {{user.email}}</p>
          </div>
        </div>

        <div class="info-grid">
          <div class="info-item">
            <div class="info-label">Phone</div>

            <div class="info-value">  
              {{#if user.phone}}
               <div class="email">{{user.phone}}</div>
            {{else}}
             <div class="email">Not Set</div>
            {{/if}}

           </div>
          </div>

          <div class="info-item">
            <div class="info-label">Member Since</div>
            <div class="info-value">{{user.createdAt}}</div>
          </div>

          <div class="info-item">
            <div class="info-label">About</div>

            <div class="info-value">{{user.about}}</div>
          </div>

           <div class="info-item">
              <div class="info-label">Preferred Sports</div>
              <div class="info-value">
                {{#if user.sports.length}}
                  <div class="sports-tags-container">
                    {{#each user.sports}}
                      <span class="sport-tag">{{this}},</span>
                    {{/each}}
                  </div>
                {{else}}
                  <span class="email">Not Set</span>
                {{/if}}
              </div>
            </div>
        </div>

        <div class="action-buttons">
          <button class="btn btn-primary">
            <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            Invite Friends
          </button>
          <button class="btn btn-secondary">
            <svg class="btn-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
            </svg>
            Share Profile
          </button>
        </div>
      </div>
  </div>

  <dialog id="modal-create" class="modal">
    {{#if user}}
      <div class="modal-content">
        <button class="close-btn" id="close-create">&times;</button>
        <h2 id="event-title-create" class="event-title">Create New Event</h2>

        <form id="create-form">
          <div id="modal-message-create" class="modal-message"></div>
          
          <div class="form-group">
            <label for="create-title">Event Title</label>
            <input type="text" id="create-title" name="title" required>
          </div>

          <div class="form-group">
            <label for="create-sport">Sport</label>
            <select id="create-sport" name="sport" required>
              <option value="">Loading sports...</option>
            </select>
          </div>

          <div class="form-group">
            <label for="create-location">Location</label>
            <input type="text" id="create-location" name="location" required>
          </div>

          <div class="form-group-row">
            <div class="form-group">
              <label for="create-date">Date</label>
              <input type="date" id="create-date" name="date" required>
            </div>
            <div class="form-group">
              <label for="create-time">Time</label>
              <input type="time" id="create-time" name="time" required>
            </div>
          </div>

          <div class="form-group-row">
              <div class="form-group">
                  <label for="create-slots">Slots (Capacity)</label>
                  <input type="number" id="create-slots" name="slots" min="1" required>
              </div>
              <div class="form-group">
                  <label for="create-fee">Fee ($)</label>
                  <input type="number" id="create-fee" name="fee" min="0" value="0" required>
              </div>
          </div>

          <div class="form-group">
            <label for="create-description">Description</label>
            <textarea id="create-description" name="description" rows="3"></textarea>
          </div>

          <div class="form-group">
            <label for="create-requirements">Requirements (e.g., "Bring shin guards")</label>
            <textarea id="create-requirements" name="requirements" rows="2"></textarea>
          </div>

          <div class="modal-actions">
            <button type="submit" class="btn btn-primary" id="confirm-create-btn">Confirm Create</button>
            <button type="button" class="btn btn-secondary" id="cancel-create">Cancel</button>
          </div>
        </form>
      </div>  
    {{/if}}
  </dialog>

  <dialog id="modal-settings" class="modal">
      <div class="modal-content">
        <button class="close-btn" id="close-settings">&times;</button>
        <h2 class="event-title">Profile Settings</h2>

        <form id="settings-form">
          <div id="modal-message-settings" class="modal-message"></div>

          <div class="form-group">
            <label for="settings-image">Profile Image URL</label>
            <input type="url" id="settings-image" name="image" placeholder="https://example.com/my-photo.jpg" value="{{user.image}}">
          </div>

          <div class="form-group">
            <label for="settings-about">About</label>
            <textarea id="settings-about" name="about" rows="3" placeholder="Tell us about yourself...">{{user.about}}</textarea>
          </div>

          <div class="form-group">
            <label for="settings-phone">Phone Number</label>
            <input type="text" id="settings-phone" name="phone" placeholder="+1 555 555 5555" value="{{user.phone}}">
          </div>

          <div class="form-group">
            <label for="settings-sports">Preferred Sports</label>
            <input type="text" id="settings-sports" name="sports" placeholder="e.g. Soccer, Basketball, Tennis" value="{{user.sports}}">
            <small style="color: #666; font-size: 0.85rem;">Separate multiple sports with commas</small>
          </div>
          
          <div class="modal-actions">
            <button type="submit" class="btn btn-primary" id="confirm-settings-btn">Save Settings</button>
            <button type="button" class="btn btn-secondary" id="cancel-settings">Cancel</button>
          </div>
        </form>
      </div>
  </dialog>

  <dialog id="modal-image-url" class="modal">
    <div class="modal-content">
      <button class="close-btn" id="close-image-modal">&times;</button>
      <h2 class="event-title">Update Profile Picture</h2>
      
      <form id="image-url-form">
        <div id="modal-message-image" class="modal-message"></div>

        <p style="margin-bottom: 15px; color: #666;">Paste a direct link to an image (ending in .jpg, .png, etc).</p>
        
        <div class="form-group">
          <label for="image-url-input">Image URL</label>
          <input type="url" id="image-url-input" name="image" placeholder="https://example.com/my-photo.jpg" required>
        </div>

        <div class="modal-actions">
          <button type="submit" class="btn btn-primary" id="confirm-image-btn">Save Image</button>
          <button type="button" class="btn btn-secondary" id="cancel-image-modal">Cancel</button>
        </div>
      </form>
    </div>
</dialog>

  <script src="myEvents.js"></script>